<Window x:Class="GoOffline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoOffline" Width="520" Height="640" MinWidth="420" MinHeight="420"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="icon.ico"
        AllowDrop="True" Drop="Window_Drop" SourceInitialized="Window_SourceInitialized">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Update banner (hidden until an update is available) -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
                CornerRadius="12" Padding="14,12" Margin="0,0,0,14"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="UpdateSubtitle" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Later" Style="{StaticResource Pill}" Padding="12,6"
                        Background="Transparent" Click="UpdateDismiss_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Update now" Style="{StaticResource PrimaryPill}"
                        Padding="14,6" Click="UpdateInstall_Click"/>
            </Grid>
        </Border>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="11" Margin="0,2,14,0" VerticalAlignment="Top">
                <Border.Background>
                    <ImageBrush ImageSource="logo.png" Stretch="UniformToFill"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FF5A6E" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="GoOffline" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Pick a program. Flip the switch. It thinks you have no internet."
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- List -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Card}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center"
                                                Margin="8,0,12,0">
                                        <ToggleButton Style="{StaticResource Switch}"
                                                      IsChecked="{Binding IsOffline, Mode=OneWay}"
                                                      Click="Toggle_Click" ToolTip="Offline on/off"/>
                                        <CheckBox Content="Hard mode" IsChecked="{Binding HardMode}"
                                                  Click="HardMode_Click"
                                                  Foreground="{StaticResource Muted}" FontSize="11"
                                                  Margin="0,6,0,0" HorizontalAlignment="Center"
                                                  ToolTip="Also inject a hook into the running process. Use for programs that still get online."/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource Pill}"
                                            Padding="9,5" Background="Transparent" Foreground="{StaticResource Muted}"
                                            Click="Remove_Click" ToolTip="Remove from list (restores internet)"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No programs yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Click “Add program” or drop an .exe here"
                           Foreground="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Restore all" Style="{StaticResource Pill}" Margin="0,0,10,0"
                    Click="RestoreAll_Click"/>
            <Button Grid.Column="2" Content="＋  Add program" Style="{StaticResource PrimaryPill}" Click="Add_Click"/>
        </Grid>
    </Grid>
</Window>
